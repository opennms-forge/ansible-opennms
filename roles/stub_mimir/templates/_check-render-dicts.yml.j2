{# Not deployed to any host. Rendered only by `make check-render`.

   The Mimir configuration file is rendered by indigo423.grafana.mimir from the
   dicts this role assembles in vars/main.yml, so the file itself belongs to the
   fork and its tests. What this collection owns is the derivation — the sorted
   join list, the replication factor capped at three, the address in every
   ring, multitenancy off — and that is what the fixtures under
   tests/render/fixtures/mimir-* pin. sort_keys=True so the recorded expectation
   does not depend on dict construction order. #}
config_extra:
{{ _mimir_config_extra | to_nice_yaml(indent=2, sort_keys=True) | indent(2, True) }}
ingester:
{{ _mimir_ingester | to_nice_yaml(indent=2, sort_keys=True) | indent(2, True) }}
distributor:
{{ _mimir_distributor | to_nice_yaml(indent=2, sort_keys=True) | indent(2, True) }}
blocks_storage:
{{ _mimir_blocks_storage | to_nice_yaml(indent=2, sort_keys=True) | indent(2, True) }}
memberlist:
{{ _mimir_memberlist | to_nice_yaml(indent=2, sort_keys=True) | indent(2, True) }}
