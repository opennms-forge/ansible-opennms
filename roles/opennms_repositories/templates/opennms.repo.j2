# DO NOT EDIT THIS FILE
# Managed by Ansible
######
# OpenNMS ships noarch packages in `common` and native ones (jicmp, jrrd2,
# iplike) per distribution. Both trees sit under the per-major branch derived
# from opennms_version, so source and version pin name one major.
#
# The key is a local file this role verified by fingerprint, so dnf never
# fetches one on its own. The repository signs its metadata too.
[opennms-common]
name=OpenNMS {{ _opennms_repo_effective_dist }} (noarch)
baseurl={{ opennms_yum_repo_url }}/{{ _opennms_repo_effective_dist }}/common
enabled=1
gpgcheck=1
repo_gpgcheck=1
gpgkey=file://{{ opennms_rpm_key_file }}

[opennms-rhel]
name=OpenNMS {{ _opennms_repo_effective_dist }} (RHEL {{ _opennms_repo_el_major }})
baseurl={{ opennms_yum_repo_url }}/{{ _opennms_repo_effective_dist }}/rhel{{ _opennms_repo_el_major }}
enabled=1
gpgcheck=1
repo_gpgcheck=1
gpgkey=file://{{ opennms_rpm_key_file }}
