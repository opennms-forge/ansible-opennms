{%- set _env_keys = _env_merged.keys() | list %}
{%- set _svc_keys = opennms_services.keys() | list %}
{%- set _collisions = (_jvm_keys | intersect(_env_keys)) + (_jvm_keys | intersect(_svc_keys)) + (_env_keys | intersect(_svc_keys)) %}
