{% endfor -%}
{% for (key, value) in _env_merged.items() -%}
{{ key }}="{{ value | string | replace('\\', '\\\\') | replace('"', '\\"') }}"
{% endfor -%}
{% for (key, value) in opennms_services.items() -%}
