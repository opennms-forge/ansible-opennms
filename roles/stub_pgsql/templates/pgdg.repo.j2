######
# One PostgreSQL major from PGDG, on the major-only EL path. PGDG keeps it at
# the same metadata as the newest minor path. The key is a local file the role
# verified by fingerprint.
[pgdg{{ pg_version }}]
name=PostgreSQL {{ pg_version }} for RHEL {{ _pgsql_el_major }} - $basearch
baseurl={{ pgsql_yum_repo_url }}/{{ pg_version }}/redhat/rhel-{{ _pgsql_el_major }}-$basearch
enabled=1
gpgcheck=1
repo_gpgcheck=1
gpgkey=file://{{ pgsql_rpm_key_file }}
