#########
# DO NOT EDIT THIS FILE
# Managed by Ansible
######
# OpenNMS ships noarch packages in `common` and native ones (jicmp, jrrd2,
# iplike) per distribution. Both trees sit under the per-major branch derived
# from opennms_version, so source and version pin name one major.
#
# The key is a local file this role verified by fingerprint, so dnf never
# fetches one on its own. The repository signs its metadata too.
[opennms-common]
name=OpenNMS opennms-36 (noarch)
baseurl=https://yum.opennms.org/opennms-36/common
enabled=1
gpgcheck=1
repo_gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-opennms

[opennms-rhel]
name=OpenNMS opennms-36 (RHEL 10)
baseurl=https://yum.opennms.org/opennms-36/rhel10
enabled=1
gpgcheck=1
repo_gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-opennms
